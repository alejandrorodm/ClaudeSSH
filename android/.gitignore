# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks

# Exception: app/debug.keystore holds Android's standard, publicly known
# debug credentials (storepass/keypass "android", alias "androiddebugkey") —
# never a secret. It's committed so every build, local or CI, signs release
# APKs with the same key (see signingConfigs in android/app/build.gradle.kts).
!app/debug.keystore
